---
// "Mandy mode": the third skin, modelled on the general structure of
// amandata.dev (Mandy's site) and re-made around Maan's own fandoms. Layout.astro
// dispatches here when the kk-skin cookie says "mandy" or is absent — this is
// the default skin (DEFAULT_SKIN in src/lib/skin.ts).
//
// Like the retro shell, there is deliberately no <ClientRouter />: amandata.dev
// itself does full page loads, and it keeps the skins from ever swapping one
// shell's markup into another's document.
//
// The sub-theme is rendered server-side onto <html> from the kk-mandy-theme
// cookie (resolved by middleware), as `data-theme="mandy-<name>"`. That value is
// both the mandy.css token selector and a DaisyUI theme, so the islands this
// skin wraps unchanged (Tetris, Tunes, the guestbook) pick up the palette. No
// pre-paint script: the attribute is already right in the HTML.
import "../styles/mandy.css";
// Self-hosted fonts (Fontsource), the same families and weights the Google
// Fonts stylesheet used to serve, from this origin with no third-party request
// in front of first paint. Latin subset only: the per-weight files that cover
// every script add ~25 KB gzipped of @font-face rules to the stylesheet every
// skin loads (Layout.astro bundles all three shells' CSS), for scripts this
// site doesn't use. Latin covers Western European accents; anything rarer
// falls back per glyph to the next font in the stack. A browser downloads a
// face only when the page renders text in it, so unused weights cost nothing.
import "@fontsource/nunito/latin-400.css";
import "@fontsource/nunito/latin-500.css";
import "@fontsource/nunito/latin-600.css";
import "@fontsource/nunito/latin-700.css";
import "@fontsource/nunito/latin-800.css";
import "@fontsource/pixelify-sans/latin-400.css";
import "@fontsource/pixelify-sans/latin-500.css";
import "@fontsource/pixelify-sans/latin-600.css";
import "@fontsource/pixelify-sans/latin-700.css";
import "@fontsource/silkscreen/latin-400.css";
import "@fontsource/silkscreen/latin-700.css";
import "@fontsource/vt323/latin-400.css";
import "@fontsource/bangers/latin-400.css";
// Preloaded: body text (Nunito) and the micro labels (VT323) appear on every
// page in every sub-theme. The display face differs by sub-theme, so it isn't.
import nunitoLatin from "@fontsource/nunito/files/nunito-latin-400-normal.woff2?url";
import vt323Latin from "@fontsource/vt323/files/vt323-latin-400-normal.woff2?url";
import OnekoToggle from "../components/OnekoToggle.tsx";
import SkinToggle from "../retro-components/SkinToggle.tsx";
import HeartRate from "../page-components/HeartRate.tsx";
import HeartRateFloat from "../page-components/HeartRateFloat.tsx";
import { heartRateEnabled, initialHeartRate } from "../lib/heartRate";
import MandyNav, { type MandyNavGroup, type MandySearchItem } from "../mandy-components/MandyNav.tsx";
import MandyEffects from "../mandy-components/MandyEffects.tsx";
import MandyBackdrop from "../mandy-components/MandyBackdrop.tsx";
import SeoHead from "./SeoHead.astro";
import { ogImageFor } from "../data/pageMeta";
import { NAV_ITEMS, SITE_TITLE, SITE_DESCRIPTION, isExternal } from "../config";
import { DEFAULT_MANDY_THEME } from "../lib/skin";
import type { LayoutProps } from "./props";

// isWide is accepted and ignored: Mandy-mode pages pick their own width with
// .md-section--wide.
type Props = LayoutProps;

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
	ogType,
	publishedTime,
	modifiedTime,
} = Astro.props;

const theme = Astro.locals.mandyTheme ?? DEFAULT_MANDY_THEME;
const formattedTitle = title === SITE_TITLE ? SITE_TITLE : `${title} | ${SITE_TITLE}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image ?? ogImageFor(Astro.url.pathname), Astro.site);
const pathname = Astro.url.pathname;
const isHome = pathname === "/";

const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);

// Dropdowns from the same NAV_ITEMS as the other shells. Plain top-level links
// become one-item entries so the nav keeps NAV_ITEMS' order.
const navGroups: MandyNavGroup[] = NAV_ITEMS.map((item, i) => {
	const links = ("items" in item ? item.items : [item]).map(link => ({
		href: link.href,
		label: link.label,
		external: isExternal(link.href),
		active: !isExternal(link.href) && isActive(link.href),
	}));
	return {
		key: `g${i}`,
		label: "items" in item ? item.label : null,
		links,
		active: links.some(link => link.active),
	};
});

// The nav search box suggests across pages, posts and projects — the same set
// the modern skin's command palette searches. Only the pages are inlined here;
// posts and projects come from /content-index.json on first search (see
// src/lib/contentIndex.ts), so the HTML doesn't grow with every post.
const searchIndex: MandySearchItem[] = [
	{ title: "Home", desc: "The front page", url: "/" },
	...NAV_ITEMS.flatMap(item => ("items" in item ? item.items : [item]))
		.filter(link => !isExternal(link.href))
		.map(link => ({ title: link.label, desc: `Page · ${link.href}`, url: link.href })),
];
---

<html lang="en" data-skin="mandy" data-theme={`mandy-${theme}`}>
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{formattedTitle}</title>
	<SeoHead
		title={formattedTitle}
		pageTitle={title}
		description={description}
		canonicalURL={canonicalURL}
		socialImage={socialImage}
		type={ogType}
		publishedTime={publishedTime}
		modifiedTime={modifiedTime}
		themeColor="#F5C518"
	/>

	<link rel="preload" href={nunitoLatin} as="font" type="font/woff2" crossorigin />
	<link rel="preload" href={vt323Latin} as="font" type="font/woff2" crossorigin />

	<!-- Critical background per sub-theme, so the first paint isn't the modern
	     skin's grey before mandy.css arrives. The bare rule is the default
	     (gotham) — keep it in step with DEFAULT_MANDY_THEME. -->
	<style is:inline>
		html[data-skin="mandy"] { background-color: #0b0c10; }
		html[data-skin="mandy"][data-theme="mandy-basement"] { background-color: #1a110c; }
		html[data-skin="mandy"][data-theme="mandy-kanto"] { background-color: #f6f4ec; }
		html[data-skin="mandy"][data-theme="mandy-inkwell"] { background-color: #f3ebd8; }
	</style>
</head>
<body>
<a href="#main-content" class="md-skip">Skip to content</a>

<MandyBackdrop client:idle />
<div class="md-vignette" aria-hidden="true"></div>

<MandyNav client:idle groups={navGroups} search={searchIndex} isHome={isHome} theme={theme} />

<main id="main-content" class="md-main">
	<slot />
</main>

<footer class="md-footer">
	<p>&copy; {new Date().getFullYear()} Maan &middot; korikosmos.dev &middot; <a href="/rss.xml">RSS</a></p>
	<p>Mandy mode &mdash; built after <a href="https://amandata.dev" target="_blank" rel="noopener">amandata.dev</a>, with love</p>
	{heartRateEnabled && <HeartRate client:idle skin="mandy" initial={initialHeartRate()} />}
</footer>

<MandyEffects client:load />
<OnekoToggle client:idle />
{heartRateEnabled && <HeartRateFloat client:idle skin="mandy" initial={initialHeartRate()} />}
<SkinToggle client:idle skin="mandy" />
</body>
</html>
