---
// The head metadata shared by both skins: description, canonical, icon, and the
// Open Graph / Twitter card tags that drive link previews in Discord, Slack,
// iMessage and friends.
//
// Deliberately output-only — it takes everything as props and emits <meta> and
// <link>, nothing else. Each shell keeps its own <title>, critical CSS, and
// scripts, because those are where the two skins genuinely differ. If this
// component ever needs to know which skin it is rendering in, it has grown past
// what it is for.
import { SITE_TITLE } from '../config';
import type { OgType } from './props';

interface Props {
  /** Already formatted as `{page} | {site}` by the caller. */
  title: string;
  /** The bare page title, for alt text that shouldn't repeat the site name. */
  pageTitle: string;
  description: string;
  canonicalURL: URL;
  socialImage: URL;
  /** `article` for blog posts, so they carry authorship and dates. */
  type?: OgType;
  /** ISO 8601. Only emitted for `type="article"`. */
  publishedTime?: string;
  modifiedTime?: string;
  /**
   * `theme-color`: Discord's embed stripe and mobile browser chrome. Mandy
   * mode passes its gotham yellow, since a crawler has no cookie and so always
   * gets Mandy mode; the other shells keep the indigo default.
   */
  themeColor?: string;
}

const {
  title,
  pageTitle,
  description,
  canonicalURL,
  socialImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  themeColor = '#818cf8',
} = Astro.props;

// The generated cards are a fixed 1200x630 (see src/lib/ogCard.ts).
// Declaring the dimensions lets a crawler reserve the large-image layout before
// it has fetched the file — without them some clients fall back to the small
// thumbnail treatment, which is most of what made the embed look plain.
const OG_IMAGE_WIDTH = '1200';
const OG_IMAGE_HEIGHT = '630';

// Built from the bare page title, not the `{page} | {site}` one — a separator
// mid-sentence reads as noise when this is spoken aloud. The homepage's page
// title *is* the site name, so it would otherwise say it twice.
const cardSubject = pageTitle === SITE_TITLE ? SITE_TITLE : `${pageTitle} — ${SITE_TITLE}`;
const imageAlt = `${cardSubject} social card: a pixel-art Gotham skyline under the Bat-Signal`;
---

<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
{/* Feed discovery for readers, in every skin. */}
<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} blog`} href="/rss.xml" />
<link rel="me" href="https://github.com/KoriKosmos" />
<meta name="generator" content={Astro.generator} />

{/* Discord tints the embed's left stripe with this, and mobile browsers use it
    for the address-bar chrome. The crawler has no cookie, so it sees Mandy
    mode, whose shell passes the gotham yellow that the generated cards
    (src/lib/ogCard.ts) are drawn in. */}
<meta name="theme-color" content={themeColor} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
{/* Kept as the full `{page} | {site}` string rather than the bare page title:
    og:site_name is rendered as separate small text by Discord, but ignored
    outright by several other clients, where a bare title loses all context. */}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_GB" />
<meta property="og:image" content={socialImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={OG_IMAGE_WIDTH} />
<meta property="og:image:height" content={OG_IMAGE_HEIGHT} />
<meta property="og:image:alt" content={imageAlt} />

{
  type === 'article' && (
    <>
      {publishedTime && <meta property="article:published_time" content={publishedTime} />}
      {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
      <meta property="article:author" content="Kori Kosmos" />
    </>
  )
}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={imageAlt} />
