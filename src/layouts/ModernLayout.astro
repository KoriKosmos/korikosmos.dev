---
// The original (and default) skin. Layout.astro dispatches here when the
// kk-skin cookie is absent or "modern"; see RetroLayout.astro for the Web 1.0
// shell and src/lib/skin.ts for how the choice is made.
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getCollection } from "astro:content";
import OnekoToggle from "../components/OnekoToggle.tsx";
import ThemeBar from "../components/ThemeBar.tsx";
import ConstellationField from "../page-components/ConstellationField.tsx";
import CommandPalette from "../page-components/CommandPalette.tsx";
import NavigationProgress from "../page-components/NavigationProgress.tsx";
import SkinToggle from "../retro-components/SkinToggle.tsx";
import SeoHead from "./SeoHead.astro";
import type { PaletteLink } from "../page-components/CommandPalette.tsx";
import { NAV_ITEMS, SITE_TITLE, SITE_DESCRIPTION } from "../config";
import {
	DEFAULT_THEME,
	getTheme,
	THEME_COOKIE,
	THEME_COOKIE_MAX_AGE,
	THEME_STORAGE_KEY,
	THEMES,
} from "../lib/theme";
import type { LayoutProps } from "./props";

type Props = LayoutProps;

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
	isWide = false,
	ogType,
	publishedTime,
	modifiedTime,
} = Astro.props;

// Rendered onto <html> below. Resolved from the kk-theme cookie by middleware,
// so the document leaves the server already themed — the inline script that
// used to be solely responsible for this can be deferred by things outside our
// control (see src/lib/theme.ts), and when it is, the page flashes the default.
const theme = getTheme(Astro);

const formattedTitle = title === SITE_TITLE ? SITE_TITLE : `${title} | ${SITE_TITLE}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image ?? '/og/site.png', Astro.site);

const isActive = (href: string) =>
	Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`);

const [paletteBlog, paletteProjects] = await Promise.all([
	getCollection("blog"),
	getCollection("projects"),
]);
const paletteLinks: PaletteLink[] = [
	{ label: "Home", href: "/", section: "Pages" },
	...NAV_ITEMS.flatMap(item => ("items" in item ? item.items : [item])).map(link => ({
		label: link.label,
		href: link.href,
		section: "Pages",
		reload: link.reload,
	})),
	...paletteBlog.map(post => ({
		label: post.data.title,
		href: `/blog/${post.slug}`,
		section: "Blog",
		keywords: post.data.description,
	})),
	...paletteProjects.map(project => ({
		label: project.data.title,
		href: `/portfolio/${project.slug}`,
		section: "Projects",
		keywords: project.data.summary,
	})),
];
---

<!-- bg-base-100 lives on <html>, not <body>, so fixed -z-10 layers (homepage starfield) can paint above it -->
<html lang="en" class="bg-base-100" data-skin="modern" data-theme={theme}>
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{formattedTitle}</title>
	<SeoHead
		title={formattedTitle}
		pageTitle={title}
		description={description}
		canonicalURL={canonicalURL}
		socialImage={socialImage}
		type={ogType}
		publishedTime={publishedTime}
		modifiedTime={modifiedTime}
	/>

	<!-- Preconnect -->
	<link rel="preconnect" href="https://lastfm.freetls.fastly.net" crossorigin />

	<!-- Critical theme backgrounds: correct paint even before the stylesheet
	     loads. <html> already carries data-theme from the cookie, so the bare
	     rule is only the first-visit default — keep it matching DEFAULT_THEME. -->
	<style is:inline>
		html { background-color: #111827; }
		html[data-theme="light"] { background-color: #F3F4F6; }
		html[data-theme="forest"] { background-color: #101B14; }
		html[data-theme="batman"] { background-color: #000000; }
		html[data-theme="spider-man"] { background-color: #10163A; }
	</style>

	<!-- Reconcile the server-rendered theme with localStorage, and re-apply after
	     every client-side navigation.

	     data-cfasync="false" opts this out of Cloudflare Rocket Loader, which
	     otherwise rewrites inline scripts to a token MIME type and replays them
	     asynchronously after load — that is what reintroduced the flash. The
	     server-rendered data-theme above is the real defence; this is the
	     fallback for the cases the cookie can't cover:
	       - a visitor whose choice predates the cookie (localStorage only),
	       - a page prefetched before the theme was changed, then swapped in by
	         ClientRouter, which resets <html>'s attributes to the stale ones. -->
	<script
		is:inline
		data-cfasync="false"
		define:vars={{
			themes: THEMES,
			fallback: DEFAULT_THEME,
			storageKey: THEME_STORAGE_KEY,
			cookie: THEME_COOKIE,
			maxAge: THEME_COOKIE_MAX_AGE,
		}}
	>
		// define:vars already wraps this in its own function scope.
		const normalise = (value) => {
			const named = value === "spiderman" ? "spider-man" : value; // pre-rename stored value
			return themes.includes(named) ? named : null;
		};
		const read = () => {
			try {
				return localStorage.getItem(storageKey);
			} catch {
				return null; // private mode: the cookie already decided the render
			}
		};

		const applyTheme = () => {
			const root = document.documentElement;
			const stored = read();
			// localStorage wins over the rendered attribute: on a swap the attribute
			// can be from a page prefetched before the theme changed.
			const theme = normalise(stored) ?? normalise(root.getAttribute("data-theme")) ?? fallback;

			if (root.getAttribute("data-theme") !== theme) root.setAttribute("data-theme", theme);
			if (stored !== theme) {
				try {
					localStorage.setItem(storageKey, theme);
				} catch {}
			}
			// Keep the cookie in step (and rolling) so the next request renders it.
			document.cookie = cookie + "=" + theme + "; path=/; max-age=" + maxAge + "; samesite=lax";
		};

		applyTheme();
		if (!window.__themeSwapHooked) {
			window.__themeSwapHooked = true;
			document.addEventListener("astro:after-swap", applyTheme);
		}
	</script>

	<ClientRouter />
</head>
<body class="font-sans text-base-content min-h-screen flex flex-col">
<ConstellationField client:load transition:persist="constellation" />
<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-content focus:rounded">
	Skip to content
</a>
<!-- Right padding keeps nav links clear of the fixed ThemeBar (search button +
     5 swatches) in the top-right corner. relative z-30 lifts the header's
     stacking context above page content so dropdown menus aren't covered by
     z-indexed elements in <main> -->
<header class="relative z-30 p-4 pr-52 sm:pr-60 border-b border-base-content/10 shrink-0" transition:name="site-header">
	<nav class="flex flex-wrap items-center gap-x-4 gap-y-1 sm:gap-x-6" aria-label="Primary">
		<a
			href="/"
			class="text-lg font-extrabold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
			aria-current={Astro.url.pathname === "/" ? "page" : undefined}
		>
			{SITE_TITLE}
		</a>
		{
			NAV_ITEMS.map(item =>
				"items" in item ? (
					<div class="dropdown dropdown-hover">
						<div
							tabindex="0"
							role="button"
							class={`nav-link cursor-pointer select-none ${item.items.some(l => isActive(l.href)) ? "text-primary" : ""}`}
						>
							{item.label}
							<svg class="inline-block w-3 h-3 ml-0.5 opacity-60" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
							</svg>
						</div>
						<ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box z-50 mt-1 w-40 p-2 shadow-lg">
							{item.items.map(link => (
								<li>
									<a href={link.href} class={isActive(link.href) ? "active" : ""} aria-current={isActive(link.href) ? "page" : undefined}>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				) : (
					<a
						href={item.href}
						class={`nav-link ${isActive(item.href) ? "text-primary" : ""}`}
						aria-current={isActive(item.href) ? "page" : undefined}
						data-astro-reload={item.reload ? true : undefined}
					>
						{item.label}
					</a>
				)
			)
		}
	</nav>
</header>

<main id="main-content" class={`${isWide ? 'max-w-7xl' : 'max-w-3xl'} mx-auto px-4 flex-grow flex flex-col justify-center w-full pb-32`}>
	<slot />
</main>

<footer class="text-center text-sm text-base-content/60 p-6 shrink-0" transition:name="site-footer">
	&copy; {new Date().getFullYear()} Maan &ndash; KoriKosmos
</footer>
<OnekoToggle client:load transition:persist="oneko-toggle" />
<ThemeBar client:load transition:persist="theme-bar" />
<SkinToggle client:load skin="modern" transition:persist="skin-toggle" />
<CommandPalette client:load transition:persist="command-palette" links={paletteLinks} />
<NavigationProgress client:load transition:persist="navigation-progress" />
</body>
</html>
