---
import { PAGE_META } from '../data/pageMeta';
import Layout from '../layouts/Layout.astro';
import { getSkin } from '../lib/skin';
import { LinksPage } from '../page-components/LinksPage.tsx';
import { RetroLinksPage } from '../retro-components/RetroLinksPage.tsx';
import { MandyLinksPage } from '../mandy-components/MandyLinksPage.tsx';

const skin = getSkin(Astro);
---

<Layout {...PAGE_META['/links']}>
  {skin === 'retro' ? <RetroLinksPage /> : skin === 'mandy' ? <MandyLinksPage /> : <LinksPage />}
</Layout>
