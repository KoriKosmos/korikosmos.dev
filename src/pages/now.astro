---
import Layout from '../layouts/Layout.astro';
import { getRecentTracks } from '../lib/lastfm';
import { trackArtistName } from '../lib/lastfmTrack';
import { getSkin } from '../lib/skin';
import { NowPage } from '../page-components/NowPage.tsx';
import { RetroNowPage } from '../retro-components/RetroNowPage.tsx';
import { MandyNowPage } from '../mandy-components/MandyNowPage.tsx';

const recentTracks = await getRecentTracks(1).catch(() => []);
const raw = recentTracks[0];
const currentTrack = raw
  ? { name: raw.name, artist: trackArtistName(raw), url: raw.url }
  : null;
const isPlaying = raw?.['@attr']?.nowplaying === 'true';
const skin = getSkin(Astro);
---

<Layout title="Now" description="What Maan is focused on right now — projects, music, and more.">
  {skin === 'retro' ? (
    <RetroNowPage currentTrack={currentTrack} isPlaying={isPlaying} />
  ) : skin === 'mandy' ? (
    <MandyNowPage currentTrack={currentTrack} isPlaying={isPlaying} />
  ) : (
    <NowPage currentTrack={currentTrack} isPlaying={isPlaying} />
  )}
</Layout>
