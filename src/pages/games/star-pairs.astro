---
import Layout from '../../layouts/Layout.astro';
import { getSkin } from '../../lib/skin';
import { StarPairs } from '../../page-components/StarPairs';
import RetroIslandShell from '../../retro-components/RetroIslandShell.astro';
import MandyIslandShell from '../../mandy-components/MandyIslandShell.astro';

const skin = getSkin(Astro);
---

<Layout title="Star Pairs" description="A constellation memory game. Match the stars, explore three board sizes, and beat your personal best.">
  <noscript><p>Star Pairs needs JavaScript to play. You can still browse the <a href="/blog">blog</a> or <a href="/portfolio">portfolio</a>.</p></noscript>
  {skin === 'retro' ? (
    <RetroIslandShell title="STARPAIRS.EXE" notes={['Match the constellations. No floppy disk required.', 'Your personal best stays on this computer.']}>
      <StarPairs client:load />
    </RetroIslandShell>
  ) : skin === 'mandy' ? (
    <MandyIslandShell
      title="Join the dots"
      tag="// memory game"
      level={0}
      notes={[
        'Flip two cards, match the constellations, clear the board.',
        'Your personal best stays on this device, like a Pokédex nobody else can see.',
      ]}
    >
      <StarPairs client:load />
    </MandyIslandShell>
  ) : <StarPairs client:load />}
</Layout>
