---
import Layout from '../../layouts/Layout.astro';
import { getSkin } from '../../lib/skin';
import { Tetris } from '../../page-components/Tetris.tsx';
import RetroIslandShell from '../../retro-components/RetroIslandShell.astro';
import MandyIslandShell from '../../mandy-components/MandyIslandShell.astro';

const skin = getSkin(Astro);
---

<Layout title="Tetris" description="Play Tetris in your browser with leaderboard support.">
  {skin === 'retro' ? (
    <RetroIslandShell
      title="TETRIS.EXE"
      blinkie="welcome"
      blinkieAlt="Welcome"
      notes={[
        '★ Use the ARROW KEYS to move and rotate. SPACE drops.',
        '★ High scores are saved to my server. No cheating!',
        '★ Shareware version. Register today for 0 additional levels.',
      ]}
    >
      <Tetris client:load />
    </RetroIslandShell>
  ) : skin === 'mandy' ? (
    <MandyIslandShell
      title="Insert coin"
      tag="// stack responsibly"
      level={0}
      notes={[
        'Arrow keys move, Z and X rotate, space hard-drops, C holds.',
        'High scores go to the server leaderboard, so play like Batman is watching. He is.',
        'Clearing four lines at once is the closest thing to a Holy Mantle this site has.',
      ]}
    >
      <Tetris client:load />
    </MandyIslandShell>
  ) : (
    <Tetris client:load />
  )}
</Layout>
