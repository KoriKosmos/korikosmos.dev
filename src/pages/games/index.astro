---
import { PAGE_META } from '../../data/pageMeta';
import Layout from '../../layouts/Layout.astro';
import { getSkin } from '../../lib/skin';
import { GamesIndexPage } from '../../page-components/GamesIndexPage.tsx';
import { RetroGamesIndexPage } from '../../retro-components/RetroGamesIndexPage.tsx';
import { MandyGamesIndexPage } from '../../mandy-components/MandyGamesIndexPage.tsx';

const skin = getSkin(Astro);
---

<Layout {...PAGE_META['/games']}>
  {skin === 'retro' ? <RetroGamesIndexPage /> : skin === 'mandy' ? <MandyGamesIndexPage /> : <GamesIndexPage />}
</Layout>
