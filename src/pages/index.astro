---
import Layout from "../layouts/Layout.astro";
import { TypingHeading } from "../page-components/TypingHeading.tsx";
import { GuestbookPage } from "../page-components/GuestbookPage.tsx";
import { getEntries } from "../lib/guestbook";

// Read the store directly rather than fetching /api/guestbook: an SSR
// self-fetch would target the container's internal origin, not the canonical
// one (see src/middleware.ts for the same class of problem).
const guestbookEntries = await getEntries();
---

<Layout description="Personal portfolio, blog, and games hub by Maan.">
	<section class="text-center pt-20 pb-12">
		<TypingHeading client:load />
		<p class="text-xl mb-10 text-base-content/70">
			Welcome to my personal space on the internet.
		</p>
		<div class="grid gap-4 sm:grid-cols-2 max-w-lg mx-auto">
			<a
				href="/portfolio"
				class="block p-6 rounded-xl bg-gradient-to-br from-primary to-secondary shadow-lg hover:scale-105 transition-transform text-primary-content"
			>
				<h2 class="text-xl font-bold mb-1">Portfolio</h2>
				<p class="text-sm opacity-80">Projects and work</p>
			</a>
			<a
				href="/blog"
				class="block p-6 rounded-xl bg-base-200 shadow-lg hover:scale-105 transition-transform"
			>
				<h2 class="text-xl font-bold mb-1">Blog</h2>
				<p class="text-sm text-base-content/60">
					Thoughts and write-ups
				</p>
			</a>
			<a
				href="/games"
				class="block p-6 rounded-xl bg-base-200 shadow-lg hover:scale-105 transition-transform"
			>
				<h2 class="text-xl font-bold mb-1">Games</h2>
				<p class="text-sm text-base-content/60">
					Tetris, RPS, and more
				</p>
			</a>
			<a
				href="/tunes"
				class="block p-6 rounded-xl bg-base-200 shadow-lg hover:scale-105 transition-transform"
			>
				<h2 class="text-xl font-bold mb-1">Tunes</h2>
				<p class="text-sm text-base-content/60">
					What I'm listening to
				</p>
			</a>
		</div>
	</section>
	<GuestbookPage client:load initialEntries={guestbookEntries} />
</Layout>
