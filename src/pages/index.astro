---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import cvData from "../data/cv.json";
import { getSkin } from "../lib/skin";
import { TypingHeading } from "../page-components/TypingHeading.tsx";
import { RetroHomePage } from "../retro-components/RetroHomePage.tsx";
import { MandyHomePage } from "../mandy-components/MandyHomePage.tsx";

const skin = getSkin(Astro);
const retro = skin === "retro";

// Only the retro and Mandy homepages need these. Retro is a 2004 front page that
// lists everything on the site; Mandy shows projects, the latest posts and counts.
// The modern homepage just links to four cards.
const [posts, projects] = skin !== "modern"
	? await Promise.all([getCollection("blog"), getCollection("projects")])
	: [[], []];
const skills = cvData.sections.find(s => s.title === "Technical Skills")?.items ?? [];
---

<Layout description="Personal portfolio, blog, and games hub by Maan.">
	{retro ? (
		<RetroHomePage
			posts={posts.map(p => ({
				slug: p.slug,
				title: p.data.title,
				description: p.data.description,
				pubDate: p.data.pubDate.toISOString(),
			}))}
			projects={projects.map(p => ({ slug: p.slug, title: p.data.title, summary: p.data.summary }))}
		/>
	) : skin === "mandy" ? (
		<MandyHomePage
			posts={posts.map(p => ({
				slug: p.slug,
				title: p.data.title,
				description: p.data.description,
				pubDate: p.data.pubDate.toISOString(),
			}))}
			projects={projects.map(p => ({ slug: p.slug, title: p.data.title, summary: p.data.summary }))}
			skills={skills}
		/>
	) : (
	<section class="text-center py-20">
		<TypingHeading client:load />
		<p class="text-xl mb-10 text-base-content/70">
			Welcome to my personal space on the internet.
		</p>
		<div class="grid gap-4 sm:grid-cols-2 max-w-lg mx-auto">
			<a
				href="/portfolio"
				class="block p-6 rounded-xl bg-gradient-to-br from-primary to-secondary shadow-lg hover:scale-105 transition-transform text-primary-content"
			>
				<h2 class="text-xl font-bold mb-1">Portfolio</h2>
				<p class="text-sm opacity-80">Projects and work</p>
			</a>
			<a
				href="/blog"
				class="block p-6 rounded-xl bg-base-200 shadow-lg hover:scale-105 transition-transform"
			>
				<h2 class="text-xl font-bold mb-1">Blog</h2>
				<p class="text-sm text-base-content/60">
					Thoughts and write-ups
				</p>
			</a>
			<a
				href="/games"
				class="block p-6 rounded-xl bg-base-200 shadow-lg hover:scale-105 transition-transform"
			>
				<h2 class="text-xl font-bold mb-1">Games</h2>
				<p class="text-sm text-base-content/60">
					Star Pairs, Tetris, and RPS
				</p>
			</a>
			<a
				href="/tunes"
				class="block p-6 rounded-xl bg-base-200 shadow-lg hover:scale-105 transition-transform"
			>
				<h2 class="text-xl font-bold mb-1">Tunes</h2>
				<p class="text-sm text-base-content/60">
					What I'm listening to
				</p>
			</a>
		</div>
	</section>
	)}
</Layout>
