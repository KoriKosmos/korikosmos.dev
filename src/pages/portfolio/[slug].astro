---
import Layout from '../../layouts/Layout.astro';
import { getEntryBySlug } from 'astro:content';
import { isRetro } from '../../lib/skin';
import { ProjectDetailPage } from '../../page-components/ProjectDetailPage.tsx';
import { RetroProjectDetailPage } from '../../retro-components/RetroProjectDetailPage.tsx';

// Server-rendered rather than prerendered — see blog/[slug].astro for why.
const { slug } = Astro.params;
const project = slug ? await getEntryBySlug('projects', slug) : undefined;
if (!project) return new Response(null, { status: 404 });

const { Content } = await project.render();
const retro = isRetro(Astro);
---

<Layout title={project.data.title} description={project.data.summary} image={`/og/portfolio/${slug}.png`}>
  {retro ? (
    <RetroProjectDetailPage project={project}>
      <Content />
    </RetroProjectDetailPage>
  ) : (
    <ProjectDetailPage project={project}>
      <Content />
    </ProjectDetailPage>
  )}
</Layout>
