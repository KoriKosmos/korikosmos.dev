---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { getSkin } from '../../lib/skin';
import { ProjectDetailPage } from '../../page-components/ProjectDetailPage.tsx';
import { RetroProjectDetailPage } from '../../retro-components/RetroProjectDetailPage.tsx';
import { MandyProjectDetailPage } from '../../mandy-components/MandyProjectDetailPage.tsx';

// Server-rendered rather than prerendered — see blog/[slug].astro, which also
// explains why this is getEntry and not the deprecated getEntryBySlug (which
// throws on a miss, so the branch below never ran and unknown slugs 500'd).
const { slug } = Astro.params;
const project = slug ? await getEntry('projects', slug) : undefined;
if (!project) return Astro.rewrite('/404');

const { Content } = await project.render();
const skin = getSkin(Astro);
---

<Layout title={project.data.title} description={project.data.summary} image={`/og/portfolio/${slug}.png`}>
  {skin === 'retro' ? (
    <RetroProjectDetailPage project={project}>
      <Content />
    </RetroProjectDetailPage>
  ) : skin === 'mandy' ? (
    <MandyProjectDetailPage project={project}>
      <Content />
    </MandyProjectDetailPage>
  ) : (
    <ProjectDetailPage project={project}>
      <Content />
    </ProjectDetailPage>
  )}
</Layout>
