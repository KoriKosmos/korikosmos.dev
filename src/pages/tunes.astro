---
import Layout from '../layouts/Layout.astro';
import { getRecentTracks, getTopArtists, getTopAlbums } from '../lib/lastfm';
import { getSkin } from '../lib/skin';
import { Tunes } from '../page-components/Tunes.tsx';
import RetroIslandShell from '../retro-components/RetroIslandShell.astro';
import MandyIslandShell from '../mandy-components/MandyIslandShell.astro';

// Independent requests run together; an upstream outage must not break the page.
const [recentTracks, topArtists, topAlbums] = await Promise.all([
  getRecentTracks(10).catch(() => []),
  getTopArtists('overall', 5, false).catch(() => []),
  getTopAlbums('overall', 5).catch(() => []),
]);

const skin = getSkin(Astro);
---

<Layout title="Tunes" description="What I'm listening to right now, powered by Last.fm scrobbles." isWide={true}>
  {skin === 'retro' ? (
    <RetroIslandShell
      title="MY MUSIC"
      blinkie="nowplaying"
      blinkieAlt="Now playing"
      notes={[
        '★ Straight from my Last.fm scrobbles, updated every 30 seconds.',
        '★ Sorry, you cannot download these. Please buy the CD.',
      ]}
    >
      <Tunes
        client:load
        recentTracks={recentTracks}
        initialArtists={topArtists}
        initialAlbums={topAlbums}
      />
    </RetroIslandShell>
  ) : skin === 'mandy' ? (
    <MandyIslandShell
      title="Tunes"
      tag="// live from Last.fm"
      level={0}
      wide
      notes={[
        'Straight from my Last.fm scrobbles; now playing refreshes every 30 seconds.',
        'Basement-run soundtrack sold separately.',
      ]}
    >
      <Tunes
        client:load
        recentTracks={recentTracks}
        initialArtists={topArtists}
        initialAlbums={topAlbums}
      />
    </MandyIslandShell>
  ) : (
    <Tunes
      client:load
      recentTracks={recentTracks}
      initialArtists={topArtists}
      initialAlbums={topAlbums}
    />
  )}
</Layout>
