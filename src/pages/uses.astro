---
import { PAGE_META } from '../data/pageMeta';
import Layout from '../layouts/Layout.astro';
import { getSkin } from '../lib/skin';
import { UsesPage } from '../page-components/UsesPage.tsx';
import { RetroUsesPage } from '../retro-components/RetroUsesPage.tsx';
import { MandyUsesPage } from '../mandy-components/MandyUsesPage.tsx';

const skin = getSkin(Astro);
---

<Layout {...PAGE_META['/uses']}>
  {skin === 'retro' ? <RetroUsesPage /> : skin === 'mandy' ? <MandyUsesPage /> : <UsesPage />}
</Layout>
