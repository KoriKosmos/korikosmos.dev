---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntryBySlug } from 'astro:content';
import { BlogPostPage } from '../../page-components/BlogPostPage.tsx';
import PostReactions from '../../page-components/PostReactions.tsx';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await getEntryBySlug('blog', slug);
const { Content } = await post.render();
---

<Layout title={post.data.title} description={post.data.description} image={`/og/blog/${slug}.png`}>
  <BlogPostPage title={post.data.title}>
    <Content />
  </BlogPostPage>
  {/* Sibling of the post, not a child: `client:*` is an Astro-template
      directive (BlogPostPage is React and couldn't apply it), and keeping the
      bar outside `.prose` stops typography styles restyling the buttons. */}
  <PostReactions client:load slug={slug} />
</Layout>
